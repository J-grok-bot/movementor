    "postinstall": "node scripts/copy-stockfish.mjs",
    "test:analysis": "tsx scripts/test-analysis.ts",
    "screenshot": "python3 scripts/screenshot.py",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
